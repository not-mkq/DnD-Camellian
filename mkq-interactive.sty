% A prebuilt appearance makes the initial counter visible even with JS disabled.
\newcommand{\MKQCounterField}[3]{%
  \begingroup
  \immediate\pdfobj stream attr{%
    /Type/XObject /Subtype/Form /FormType 1 /BBox[0 0 150 24]
    /Resources<</Font<</Helv \OBJ@Helv\space 0 R>>>>
  }{q #2 rg BT /Helv 16 Tf 5 6 Td (#1) Tj ET Q}%
  \edef\mkq@counterobject{\the\pdflastobj}%
  \apptocmd{\PDFForm@Text}{/AP<</N \mkq@counterobject\space 0 R>>}{}{}%
  \def\LayoutTextField##1##2{##2}%
  \TextField[name=mkq-prepared-count,altname={准备数／上限：不统计固定状态法术},
    width=150bp,height=24bp,readonly=true,print=true,
    borderwidth=0,bordercolor={},backgroundcolor={},
    charsize=16pt,color={#2},value={#1},default={#1},
    calculate={#3},calculatesortkey=1]{}%
  \endgroup
}
% Editable numeric entries, with a transparent background and centered text.
% Arguments: field name, tooltip, initial digits (or empty), width/height/font
% size in bp. The initial appearance uses Helvetica's tabular digit width;
% edited values use automatic font sizing so longer coin totals still fit.
% Editing and saving these ordinary text fields does not require JavaScript.
\ExplSyntaxOn
\cs_new:Npn \mkq@numberx #1#2#3
  {\fp_eval:n {(#1 - 0.556 * #2 * \str_count:n {#3}) / 2}}
\cs_new:Npn \mkq@numbery #1#2
  {\fp_eval:n {(#1 - 0.718 * #2) / 2}}
\ExplSyntaxOff
\newcommand{\MKQNumberField}[6]{%
  \begingroup
  \immediate\pdfobj stream attr{%
    /Type/XObject /Subtype/Form /FormType 1 /BBox[0 0 #4 #5]
    /Resources<</Font<</Helv \OBJ@Helv\space 0 R>>>>
  }{q 0.1 0.1 0.1 rg BT /Helv #6 Tf
    \mkq@numberx{#4}{#6}{#3} \mkq@numbery{#5}{#6} Td
    (\pdf@escapestring{#3}) Tj ET Q}%
  \edef\mkq@numberobject{\the\pdflastobj}%
  \apptocmd{\PDFForm@Text}{/AP<</N \mkq@numberobject\space 0 R>>}{}{}%
  \def\LayoutTextField##1##2{##2}%
  \TextField[name={#1},altname={#2},width=#4bp,height=#5bp,
    readonly=false,print=true,align=1,
    borderwidth=0,bordercolor={},backgroundcolor={},
    charsize=0pt,color={0.1 0.1 0.1},value={#3},default={#3}]{}%
  \endgroup
}
% Native multiline note. The initial appearance is typeset with the sheet's
% font; its editable default appearance uses the complete embedded CJK font.
\newsavebox{\mkq@notebox}
\newcommand{\MKQResourceNoteField}[5]{%
  \begingroup
  \sbox{\mkq@notebox}{\pdfliteral{q Q}\parbox[c][#3bp][c]{#2bp}{%
    \hspace*{2bp}\parbox{\dimexpr#2bp-4bp\relax}{%
      \entryfont\fontsize{7bp}{8.5bp}\selectfont\raggedright #4}}}%
  \immediate\saveboxresource\mkq@notebox
  \edef\mkq@noteobject{\the\lastsavedboxresourceindex}%
  \patchcmd{\PDFForm@Text}{/Helv}{/MKQNotes}{}{}%
  \apptocmd{\PDFForm@Text}{/AP<</N \mkq@noteobject\space 0 R>>}{}{}%
  \appto\pdfstringdefPreHook{\def\\{\textCR}}% preserve source line breaks in /V
  \def\LayoutTextField##1##2{##2}%
  \TextField[name={#1},altname={#5：备注，可编辑},width=#2bp,height=#3bp,
    readonly=false,multiline=true,print=true,align=0,
    borderwidth=0,bordercolor={},backgroundcolor={},
    charsize=7bp,color={0.1 0.1 0.1},value={#4},default={#4}]{}%
  \endgroup
}
\makeatother

% Internal widget: optional size, stable field name, default state, read-only,
% tooltip. No field is placed inside the repeatedly measured fitbox environment.
\NewDocumentCommand{\MKQCheck}{O{8pt} m m m m}{%
  \begingroup
  \def\LayoutCheckField##1##2{##2}% no empty-label padding
  \CheckBox[name={#2},altname={#5},width=#1,height=#1,
    borderwidth=0,bordercolor={},backgroundcolor={},color={0.1 0.1 0.1},
    checkboxsymbol={\ding{108}},
    checked=#3,readonly=#4,print=true]{}%
  \endgroup
}

