% The supplied PSTricks template places the sheet at this origin. PDF widgets
% must be emitted in the shipout overlay, outside PSTricks' transformed boxes.
\NewDocumentCommand{\MKQAtSheet}{m m m}
{
  \put(\fp_eval:n{0.75*(#1)-2.632}pt,\fp_eval:n{0.75*(#2)+2.9684}pt)
    {\makebox(0,0){#3}}
}
\cs_new_protected:Npn \mkq_spell_widget:nnnnnn #1#2#3#4#5#6
{
  \MKQAtSheet{\mkq_column_x:n {#1}}{\mkq_first_y:n {#1}-(#2-1)*18.6666662}
    {\MKQCheck[7.3pt]{#3}{#4}{#5}{#6：准备状态}}
}
\NewDocumentCommand{\MKQRenderPreparedHalf}{}
{
  \AddToShipoutPictureFG*{\AtPageLowerLeft{
    \seq_map_inline:Nn \g_mkq_spell_fields_seq {##1}
    \seq_map_inline:Nn \g_mkq_slots_seq {##1}
    \mkq_render_counter:
  }}
}
% Acrobat Calculate action. Read only counted, editable preparation fields.
% No file/network access and no global Reader settings are changed.
\cs_new:Npn \mkq_counter_js:
{
  var~mkqCount=0;
  var~mkqNames=[\seq_use:Nn \g_mkq_counted_names_seq {,}];
  for(var~mkqI=0;mkqI<mkqNames.length;mkqI++){
    var~mkqField=this.getField(mkqNames[mkqI]);
    if(mkqField&&mkqField.isBoxChecked(0)){mkqCount++;}
  }
  var~mkqMax=\int_use:N \g_mkq_prepared_limit_int;
  event.value=mkqCount+"~/~"+mkqMax+
    (mkqCount>mkqMax?"~(+"+(mkqCount-mkqMax)+")":"");
  event.target.textColor=mkqCount>mkqMax?["RGB",0.75,0.08,0.08]:["RGB",0.10,0.10,0.10];
}
\cs_new_protected:Npn \mkq_render_counter:
{
  \tl_set:Nx \l_mkq_counter_text_tl
    {\int_use:N \g_mkq_initial_prepared_int\c_space_tl/\c_space_tl\int_use:N \g_mkq_prepared_limit_int}
  \tl_set:Nn \l_mkq_counter_color_tl {0.10~0.10~0.10}
  \int_compare:nNnT {\g_mkq_initial_prepared_int}>{\g_mkq_prepared_limit_int}
  {
    \tl_put_right:Nx \l_mkq_counter_text_tl
      {\c_space_tl(+\int_eval:n{\g_mkq_initial_prepared_int-\g_mkq_prepared_limit_int})}
    \tl_set:Nn \l_mkq_counter_color_tl {0.75~0.08~0.08}
  }
  \MKQAtSheet{157}{660}
  {
    \setlength{\fboxsep}{5pt}
    \fcolorbox{outline-color}{white!90!yellow}{\parbox[c][61pt][c]{156pt}{\entryfont
      \fontsize{9pt}{12pt}\selectfont\textbf{准备法术}\hfill 已准备／上限
      \\[27pt]
      \fontsize{7pt}{9pt}\selectfont 不含固定状态；超额标红~+N
    }}
  }
  \MKQAtSheet{156}{657}
    {\MKQCounterField{\l_mkq_counter_text_tl}{\l_mkq_counter_color_tl}{\mkq_counter_js:}}
}
\cs_new:Npn \mkq_slots_x:n #1
  {\int_case:nn {#1}{{1}{201.03045507}{2}{453.03044877}{3}{453.03044877}{4}{702.53044253}{5}{702.53044253}}}
\cs_new:Npn \mkq_slots_y:n #1
  {\int_case:nn {#1}{{1}{563.85545107}{2}{847.49771214}{3}{431.71745300}{4}{847.49771214}{5}{431.161453}}}
\cs_new_protected:Npn \mkq_slots_widget:nn #1#2
{
  \MKQAtSheet{\mkq_slots_x:n {#1}}{\mkq_slots_y:n {#1}}
  {
    \int_step_inline:nn {#2}
    {
      \MKQCheck[9pt]{slot-#1-##1}{false}{false}{#1环法术位~##1：勾选表示已消耗}
      \int_compare:nNnT {##1}<{#2}{\hspace{3pt}}
    }
  }
}
\NewDocumentCommand{\UsedSlotsMKQ}{m m}
  {\seq_gput_right:Nn \g_mkq_slots_seq {\mkq_slots_widget:nn {#1}{#2}}}
