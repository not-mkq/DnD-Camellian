  {/Helv \OBJ@Helv\space 0 R /MKQNotes \MKQResourceFontObject\space 0 R}
  {}{\PackageError{mkq-interactive}{Cannot add resource note font to AcroForm}{}}
\AtBeginDocument{%
  \HyField@NeedAppearancesfalse
  \immediate\pdfobj stream attr{%
    /Type/XObject /Subtype/Form /FormType 1 /BBox[0 0 10 10] /Resources<<>>
  }{q 1 1 1 rg 0.1 0.1 0.1 RG 0.8 w
    5 0.8 m 7.3196 0.8 9.2 2.6804 9.2 5 c
    9.2 7.3196 7.3196 9.2 5 9.2 c
    2.6804 9.2 0.8 7.3196 0.8 5 c
    0.8 2.6804 2.6804 0.8 5 0.8 c h B Q}%
  \xdef\mkq@offobject{\the\pdflastobj}%
  \immediate\pdfobj stream attr{%
    /Type/XObject /Subtype/Form /FormType 1 /BBox[0 0 10 10] /Resources<<>>
  }{q 0.1 0.1 0.1 rg 0.1 0.1 0.1 RG 0.8 w
    5 0.8 m 7.3196 0.8 9.2 2.6804 9.2 5 c
