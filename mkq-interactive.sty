\cs_new:Npn \mkq_level_word:n #1
  {\int_case:nn {#1}{{1}{First}{2}{Second}{3}{Third}{4}{Fourth}{5}{Fifth}}}
\cs_new:Npn \mkq_capacity:n #1
  {\int_case:nn {#1}{{1}{26}{2}{19}{3}{19}{4}{19}{5}{18}}}

% Four required arguments, plus an optional trailing [True] or [False].
% Omitted: editable and counted. Explicit: locked and excluded from the count.
% Every spell level has its own counter. Field IDs use names, not row letters,
% so inserting a spell does not accidentally bind a different spell's checkbox.
\NewDocumentCommand{\spellMKQ}{m m m m o}
{
  \int_compare:nNnTF {#1}<{1}
    {\PackageError{mkq-interactive}{Spell~level~must~be~1--5}{}}
    {
      \int_compare:nNnTF {#1}>{5}
        {\PackageError{mkq-interactive}{This~half~sheet~supports~levels~1--5}{}}
        {\mkq_add_spell:nnnnn {#1}{#2}{#3}{#4}{#5}}
    }
}
\cs_new_protected:Npn \mkq_add_spell:nnnnn #1#2#3#4#5
{
  \int_gincr:c {g_mkq_level_#1_int}
  \int_compare:nNnTF {\int_use:c {g_mkq_level_#1_int}}>{\mkq_capacity:n {#1}}
    {\PackageError{mkq-interactive}{Too~many~level~#1~spells~for~this~sheet}
      {The~half~sheet~has~26/19/19/19/18~rows~for~levels~1--5.}}
    {
      \tl_set:Nx \l_mkq_letter_tl {\int_to_Alph:n {\int_use:c {g_mkq_level_#1_int}}}
      \tl_set:Nx \l_mkq_prefix_tl {\mkq_level_word:n {#1}LevelSpellSlot\l_mkq_letter_tl}
      \use:c {\l_mkq_prefix_tl}
        {#2~(#3)\tl_if_blank:nF {#4}{~#4}}
      % The printed circles are replaced by widgets on the interactive sheet.
      \use:c {\l_mkq_prefix_tl Prepared}{False}
      \tl_set:Nx \l_mkq_field_tl {\str_lowercase:n {#2}}
      \regex_replace_all:nnN {[^a-z0-9]+}{-} \l_mkq_field_tl
      \tl_put_left:Nn \l_mkq_field_tl {prep-#1-}
      \exp_args:NNV \prop_if_in:NnTF \g_mkq_field_names_prop \l_mkq_field_tl
        {\PackageError{mkq-interactive}{Duplicate~spell~field:~#2}{}}
        {\exp_args:NNV \prop_gput:Nnn \g_mkq_field_names_prop \l_mkq_field_tl {#3}}
      \tl_set:Nn \l_mkq_checked_tl {false}
      \tl_set:Nn \l_mkq_readonly_tl {false}
      \clist_if_in:NnT \g_mkq_prepared_clist {#2}
        {\tl_set:Nn \l_mkq_checked_tl {true}}
      \clist_if_in:NnT \g_mkq_always_clist {#2}
        {\tl_set:Nn \l_mkq_checked_tl {true}\tl_set:Nn \l_mkq_readonly_tl {true}}
      \IfNoValueF{#5}
      {
        \tl_set:Nx \l_mkq_fixed_tl {\str_lowercase:n {#5}}
        \tl_trim_spaces:N \l_mkq_fixed_tl
        \str_case:VnF \l_mkq_fixed_tl
          {{true}{\tl_set:Nn \l_mkq_checked_tl {true}}
           {false}{\tl_set:Nn \l_mkq_checked_tl {false}}}
          {\PackageError{mkq-interactive}{Optional~state~must~be~True~or~False}
            {Omit~the~option~for~an~editable,~counted~spell.}}
        \tl_set:Nn \l_mkq_readonly_tl {true}
      }
      \tl_if_eq:NnT \l_mkq_readonly_tl {false}
      {
        \seq_gput_right:Nx \g_mkq_counted_names_seq {"\l_mkq_field_tl"}
        \tl_if_eq:NnT \l_mkq_checked_tl {true}
          {\int_gincr:N \g_mkq_initial_prepared_int}
      }
      \seq_gput_right:Nx \g_mkq_spell_fields_seq
      {
        \exp_not:N \mkq_spell_widget:nnnnnn
        {#1}{\int_use:c {g_mkq_level_#1_int}}
        {\l_mkq_field_tl}{\l_mkq_checked_tl}{\l_mkq_readonly_tl}{\exp_not:n {#3}}
      }
    }
}

